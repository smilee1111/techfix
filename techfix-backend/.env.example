# Copy this file to .env and fill in real values. Never commit the real .env.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/techfix

# Must match the frontend's origin (comma-free, single origin)
CORS_ORIGIN=http://localhost:3000

# Use long, random strings in real environments (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# Optional — falls back to JWT_ACCESS_SECRET if omitted
RESET_PASSWORD_SECRET=
RESET_PASSWORD_EXPIRES_IN=30m

# Optional — omit all four to log reset-password emails to the console instead of sending them
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=TechFix <no-reply@techfix.com>

# Used to build the password-reset link emailed to users
FRONTEND_URL=http://localhost:3000
